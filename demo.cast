[0.004561, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.005042, "o", "\u001b[1m╔══════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1m║   MaroonedPods: Sovereign Tenant Cluster on KubeVirt VMs   ║\u001b[0m\r\n\u001b[1m╚══════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n  Management cluster:  OCP 5.0 + KubeVirt 1.8 + HyperShift\r\n  Tenant cluster:      OCP 4.20 (fully virtualized control plane + workers)\r\n\r\n    Management Cluster\r\n    ├── HostedCluster (OCP 4.20)\r\n    ├── CP VM (bridge binding, auto-proxy, OVS masked)\r\n    │   └── etcd, kube-apiserver, router, ignition-server ...\r\n    └── Worker VM (NodePool + MachineConfig)\r\n        └── kubelet → registers with tenant kapi\r\n"]
[5.006401, "o", "\r\n\u001b[0;36m▸ Step 1: The HostedCluster is running on OCP 4.20\u001b[0m\r\n"]
[7.008285, "o", "\u001b[1;33m$ kubectl get hostedcluster -n clusters tenant-clean\u001b[0m\r\n"]
[7.899734, "o", "NAME           VERSION   CP VERSION   KUBECONFIG                      PROGRESS   AVAILABLE   PROGRESSING   MESSAGE\r\ntenant-clean                          "]
[7.899761, "o", "tenant-clean-admin-kubeconfig   Partial    False       False         Get \"https://192.168.2.200:443/healthz\": context deadline exceeded (Client.Timeout exceeded while awaiting headers)\r\n"]
[8.905321, "o", "\r\n\u001b[0;36m▸ Step 2: Control plane runs inside a KubeVirt VM with bridge binding\u001b[0m\r\n"]
[10.907078, "o", "\u001b[1;33m$ kubectl get vmi -n clusters-tenant-clean -l maroonedpods.io/group\u001b[0m\r\n"]
[11.77244, "o", "NAME                                       AGE    PHASE     IP        "]
[11.772845, "o", "     NODENAME                            READY\r\nmaroonedpods-group-clusters-tenant-clean   162m   Running   10.129.3.112   virt-den-422-nmn8f-worker-0-fbhs6   True\r\n"]
[12.778373, "o", "\r\n\u001b[0;36m▸ Step 3: HyperShift CP pods run on the virtual node (the KubeVirt VM)\u001b[0m\r\n"]
